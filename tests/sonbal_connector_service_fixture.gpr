with "clair.gpr";
with "clair_config.gpr";
with "../sonbal_config.gpr";

project Sonbal_Connector_Service_Fixture is
   for Languages use ("Ada");
   for Source_Dirs use
     ("../src", "../src/platform/" & Clair_Config.Target_OS, ".");
   for Object_Dir use
     Sonbal_Config.Tests_Object_Root & "/connector-service-fixture";
   for Exec_Dir use Sonbal_Config.Tests_Exec_Dir;
   for Create_Missing_Dirs use "True";
   for Main use ("sonbal_connector_service_fixture.adb");

   package Builder is
      for Executable ("sonbal_connector_service_fixture.adb") use
        "sonbal-connector-service-fixture";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe",
         "-O0", "-g");
   end Compiler;

   package Linker renames Clair_Config.Linker;
end Sonbal_Connector_Service_Fixture;
