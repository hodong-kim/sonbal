set -e

#DEBHELPER#

purge_enable_link()
{
    link=$1
    expected_target=$2

    if [ ! -e "$link" ] && [ ! -L "$link" ]; then
        return 0
    fi
    if [ ! -L "$link" ]; then
        echo "sonbal: refusing to purge unexpected systemd enable path $link" >&2
        return 1
    fi
    target=$(/usr/bin/readlink -m "$link") || return 1
    if [ "$target" != "$expected_target" ]; then
        echo "sonbal: refusing to purge unexpected systemd enable target for $link" >&2
        return 1
    fi
    /bin/rm -f "$link"
}

if [ "$1" = purge ]; then
    if [ -x /usr/bin/deb-systemd-helper ]; then
        /usr/bin/deb-systemd-helper purge sonbal-openai.service >/dev/null || true
    fi
    purge_enable_link \
        /etc/systemd/system/multi-user.target.wants/sonbal-openai.service \
        /usr/lib/systemd/system/sonbal-openai.service
fi

case "$1" in
    remove|purge)
        if [ -d /run/systemd/system ]; then
            /usr/bin/systemctl --system daemon-reload >/dev/null || {
                echo "sonbal: failed to reload systemd manager during package removal" >&2
                exit 1
            }
        fi
        ;;
esac

exit 0
